# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/wype

# Auth / JWT
# Generate a strong secret, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Magic link base URL (defaults to http://localhost:3000, i.e. the API, in dev)
FRONTEND_URL=https://wype.live

# Blip Pay (self-custody funding + movement)
BLIP_BASE_URL=https://blippay.me

# Twilio (WhatsApp integration)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=+14155238886

# Quai Network
# Zone-specific endpoint — the bare host 404s, the /cyprus1 path is the real one.
#   Orchard testnet, Cyprus-1  chainId 15000  https://orchard.rpc.quai.network/cyprus1
#   Mainnet,         Cyprus-1  chainId 9      https://rpc.quai.network/cyprus1
QUAI_RPC_URL=https://orchard.rpc.quai.network/cyprus1

# On-chain escrow (contracts/). Leave these blank to keep the in-memory
# simulation — the API runs fine without them, it just doesn't settle on-chain.
# Deployed on Orchard testnet, Cyprus-1:
WYPE_ESCROW_ADDRESS=0x0026622A9d39b81a8C20FabD10f43A8F89D6c608

# On-chain username registry (contracts/). Optional — the API works without it,
# but registering a name will also write on-chain for cross-platform resolution.
WYPE_REGISTRY_ADDRESS=

# Funded Cyprus-1 key that locks and settles escrows. Generate with
# `node contracts/script/quai-keygen.mjs` — a key from cast/MetaMask lands in
# the wrong zone and Quai will reject it.
WYPE_TREASURY_PRIVATE_KEY=0x...

# Key that signs claim authorisations. Must match the `verifier` the contract
# was deployed with. Keep it out of the frontend.
ESCROW_VERIFIER_PK=0x...

# Escrow lock duration in seconds (default 7 days = 604800)
QUAI_ESCROW_DURATION=604800

# Resend (email delivery)
# Get your API key from https://resend.com/api-keys
# After verifying wype.live domain, update the from address
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM=Wype <noreply@wype.live>

# Voice notes (mock speech-to-text)
# What a recorded voice note should "say" while STT is mocked. Leave empty to
# make the bot reply "could not understand" so you can test the fallback path.
MOCK_VOICE_TRANSCRIPT=Send 10 QUAI to basil.quai

# Real speech-to-text (uncomment + set OPENAI_API_KEY to switch from the mock)
# OPENAI_API_KEY=sk-...
