# ---------------------------------------------------------------------------
# TEMPLATE ONLY. This file is COMMITTED TO GIT.
# Never put a real private key here. Copy it to `.env` (gitignored) and fill
# that in instead:  cp .env.example .env
# ---------------------------------------------------------------------------

# Quai RPC endpoint. Zone-specific — the bare host 404s, the /cyprus1 path is
# the actual JSON-RPC endpoint. Verified live:
#   Orchard testnet, Cyprus-1  chainId 15000  https://orchard.rpc.quai.network/cyprus1
#   Mainnet,         Cyprus-1  chainId 9      https://rpc.quai.network/cyprus1
QUAI_RPC_URL=https://orchard.rpc.quai.network/cyprus1

# Funded key that pays for the deployment transaction.
# Must be a Cyprus-1 address — generate with `node script/quai-keygen.mjs`.
DEPLOYER_PRIVATE_KEY=0x...

# Backend key whose signature authorises claims. This is the key the Wype API
# signs with — keep it out of the repo and out of the frontend.
ESCROW_VERIFIER=0x...

# Address allowed to rotate the verifier. Defaults to the deployer.
# Use a separate key from ESCROW_VERIFIER so a backend compromise is recoverable.
ESCROW_OWNER=0x...
